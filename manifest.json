{
    "manifest_version":  3,
    "name":  "Cinnamon Boost",
    "version":  "0.33.0",
    "author":  "Nour Tammous",
    "homepage_url":  "https://github.com/NourZohdy/cinnamon-boost",
    "description":  "Faster, sound-first Label Studio for audio/video transcription: compact layout, segment list, preloading, local cache and shortcuts.",
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "permissions":  [
                        "storage"
                    ],
    "action":  {
                   "default_popup":  "src/popup/popup.html",
                   "default_title":  "Cinnamon Boost: settings",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "background":  {
                       "service_worker":  "src/background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://annotation.dlnlp.ai/*"
                                            ],
                                "js":  [
                                           "src/shared/settings.js",
                                           "src/shared/update.js",
                                           "src/page/helpers.js",
                                           "src/page/runtime.js",
                                           "src/page/features/cache.js",
                                           "src/page/features/preload.js",
                                           "src/page/features/toolbar.js",
                                           "src/page/features/sound.js",
                                           "src/page/features/layout.js",
                                           "src/page/features/segments.js",
                                           "src/page/features/pager.js",
                                           "src/page/features/gestures.js",
                                           "src/page/features/overview.js",
                                           "src/page/features/keyboard.js",
                                           "src/page/content.js"
                                       ],
                                "world":  "MAIN",
                                "run_at":  "document_start"
                            },
                            {
                                "matches":  [
                                                "https://annotation.dlnlp.ai/*"
                                            ],
                                "js":  [
                                           "src/background.js"
                                       ],
                                "css":  [
                                            "src/page/content.css"
                                        ],
                                "run_at":  "document_start"
                            }
                        ]
}
